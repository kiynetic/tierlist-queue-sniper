{
  "name": "qpilot",
  "productName": "qPilot",
  "version": "1.1.0",
  "description": "qPilot - Fast Discord Tierlist Waitlist Sniper",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "package": "electron-packager . qPilot --platform=win32 --arch=x64 --out=dist --overwrite --icon=src/assets/icon.ico --asar --ignore=\"^/\\.qpilot_data\" --ignore=\"^/dist\" --ignore=\"^/\\.git\" --prune=true",
    "build:portable": "powershell -ExecutionPolicy Bypass -File build/build.ps1 -Target Portable",
    "build:installer": "powershell -ExecutionPolicy Bypass -File build/build.ps1 -Target Installer",
    "build:all": "powershell -ExecutionPolicy Bypass -File build/build.ps1 -Target All"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^3.0.2"
  }
}
